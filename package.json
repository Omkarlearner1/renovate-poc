{
  "name": "angular-vuln-agent",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "audit:json": "npm audit --json > npm-audit.json || true",
    "audit:summary": "node scripts/summarize-audit.js npm-audit.json",
    "security:scan": "npm run audit:json && npm run audit:summary"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
